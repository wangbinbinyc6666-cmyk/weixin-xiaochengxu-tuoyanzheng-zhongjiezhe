page {
  background: #F8F9FA;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

button {
  background: initial;
  border: none;
  padding: 0;
  line-height: inherit;
  font-size: inherit;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
