<view class="step-card {{completed ? 'completed' : ''}} {{skipped ? 'skipped' : ''}}">
  <view class="step-row">
    <view class="step-circle-icon {{completed ? 'done' : ''}} {{skipped ? 'skipped-icon' : ''}}"
      style="background: {{completed ? '#2ECC71' : (skipped ? '#999999' : circleColor)}}">
      <text wx:if="{{completed}}" class="circle-check">✓</text>
      <text wx:elif="{{skipped}}" class="circle-skip">—</text>
      <text wx:else class="circle-num">{{index + 1}}</text>
    </view>
    <view class="step-info">
      <view class="step-text-wrap">
        <text class="step-title {{(completed || skipped) ? 'dimmed' : ''}}">{{step.content}}</text>
        <view class="strike-line {{strikeAnimate ? 'animate' : ''}}"></view>
      </view>
      <text class="step-desc {{(completed || skipped) ? 'dimmed' : ''}}" wx:if="{{step.description}}">{{step.description}}</text>
    </view>
  </view>

  <view class="step-actions" wx:if="{{!completed && !skipped}}">
    <view class="btn-complete" bindtap="onComplete">完成</view>
    <view class="btn-skip" bindtap="onSkip">跳过</view>
  </view>

  <view class="step-status-text" wx:if="{{completed}}">
    <text>✓ 已完成 · 执行力 +2 · 咖啡豆 +1</text>
  </view>
  <view class="step-status-text skipped-status" wx:if="{{skipped}}">
    <text>— 已跳过</text>
  </view>
</view>
