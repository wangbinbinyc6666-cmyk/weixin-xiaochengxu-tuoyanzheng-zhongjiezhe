.step-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.step-card.completed {
  border-left: 8rpx solid #7ED321;
  opacity: 0.85;
  background: #F9FFF5;
}

.step-card.skipped {
  border-left: 8rpx solid #F5A623;
  opacity: 0.75;
}

.step-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.step-icon {
  font-size: 40rpx;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F7FA;
  border-radius: 12rpx;
}

.completed .step-icon {
  background: #E8F8D0;
}

.skipped .step-icon {
  background: #FFF0E0;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
}

.step-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
  background: #7ED321;
  color: #FFFFFF;
}

.step-badge.skip {
  background: #F5A623;
}

.step-meta {
  margin-top: 16rpx;
  margin-left: 72rpx;
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #999999;
}

.step-actions {
  margin-top: 20rpx;
  margin-left: 72rpx;
  display: flex;
  gap: 16rpx;
}

.btn-complete,
.btn-skip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.btn-complete {
  background: #7ED321;
  color: #FFFFFF;
}

.btn-skip {
  background: #F0F0F0;
  color: #999999;
}

.btn-icon {
  font-size: 24rpx;
}

.step-status {
  margin-top: 16rpx;
  margin-left: 72rpx;
  font-size: 24rpx;
}

.status-complete {
  color: #7ED321;
  font-weight: 500;
}

.status-skipped {
  color: #F5A623;
  font-weight: 500;
}
