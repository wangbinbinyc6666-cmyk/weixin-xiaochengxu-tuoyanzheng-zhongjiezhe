.step-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.step-card.completed {
  opacity: 0.85;
  background: #F9FFF5;
}

.step-card.skipped {
  opacity: 0.75;
}

.step-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

/* Circle Icon */
.step-circle-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  transition: background 0.3s ease, transform 0.3s ease;
}

.step-circle-icon.done {
  background: #2ECC71;
  transform: scale(1.1);
}

.step-circle-icon.skipped-icon {
  background: #999999;
}

.circle-check,
.circle-skip {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.circle-check {
  animation: popIn 300ms ease-out;
}

@keyframes popIn {
  from { transform: scale(0); }
  to { transform: scale(1); }
}

.circle-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* Step Info */
.step-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.step-text-wrap {
  position: relative;
  display: inline-block;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.5;
  word-break: break-all;
}

.step-title.dimmed {
  color: #999999;
}

/* Strikethrough Line - using real view element for reliable animation */
.strike-line {
  position: absolute;
  left: 0;
  top: 50%;
  width: 0;
  height: 3rpx;
  background: #1A1A1A;
  transform: translateY(-50%);
  transition: width 300ms ease-out;
}

.strike-line.animate {
  width: 100%;
}

.step-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
}

.step-desc.dimmed {
  color: #999999;
}

/* Actions */
.step-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-left: 88rpx;
}

.btn-complete,
.btn-skip {
  padding: 12rpx 32rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 200ms ease, background 200ms ease;
}

.btn-complete {
  background: #1A1A1A;
  color: #FFFFFF;
}

.btn-skip {
  background: #F0F0F0;
  color: #999999;
}

/* Status Text */
.step-status-text {
  margin-top: 16rpx;
  padding-left: 88rpx;
  font-size: 24rpx;
  color: #2ECC71;
  font-weight: 500;
}

.step-status-text.skipped-status {
  color: #999999;
}
