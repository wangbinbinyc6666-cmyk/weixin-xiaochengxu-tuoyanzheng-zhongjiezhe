.container {
  padding: 32rpx;
  position: relative;
}

/* Reward Toast */
.reward-toast {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
  pointer-events: none;
  opacity: 0;
  transform: translateY(-40rpx);
  transition: all 0.3s ease;
}

.reward-toast.show {
  opacity: 1;
  transform: translateY(0);
}

.reward-content {
  background: #F39C12;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(243, 156, 18, 0.4);
}

.reward-thumb {
  font-size: 40rpx;
}

.reward-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* Coach Greeting */
.coach-greeting {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-bottom: 24rpx;
}

.coach-avatar-small {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
}

.speech-bubble {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.08);
  flex: 1;
  position: relative;
  line-height: 1.6;
}

.speech-bubble::before {
  content: '';
  position: absolute;
  left: -16rpx;
  top: 20rpx;
  width: 0;
  height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-right: 16rpx solid #FFFFFF;
}

/* Plan Card */
.plan-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.08);
}

.plan-hint {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
  border-bottom: 2rpx solid #E0E0E0;
}

.plan-task {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.5;
}

/* Steps Section */
.steps-section {
  margin-top: 16rpx;
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 24rpx;
}

/* Completion Dialog */
.completion-dialog {
  display: flex;
  justify-content: center;
  padding: 0 0 24rpx;
}

.completion-bubble {
  max-width: 80%;
  text-align: center;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.6;
}

.completion-bubble::before {
  display: none;
}

/* Completion: Full Body Coach */
.coach-full {
  display: flex;
  justify-content: center;
  padding: 32rpx 0 16rpx;
}

.coach-full-img {
  width: 192rpx;
  height: 192rpx;
}

/* Completion: Title */
.completion-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.confetti {
  font-size: 48rpx;
}

.completion-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #1A1A1A;
}

/* Completion: Status Bar */
.status-bar {
  text-align: center;
  font-size: 32rpx;
  color: #1A1A1A;
  padding: 16rpx 0 32rpx;
  font-weight: 500;
}

/* Completed Task List */
.completed-tasks {
  margin-bottom: 32rpx;
}

.completed-task-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.08);
}

.task-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  overflow: hidden;
}

.task-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.task-content {
  font-size: 28rpx;
  color: #666666;
  text-decoration: line-through;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-stamp {
  border: 4rpx solid #E74C3C;
  color: #E74C3C;
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  transform: rotate(-5deg);
}

/* Action Buttons */
.action-buttons {
  display: flex;
  gap: 24rpx;
  padding: 16rpx 0;
}

.btn-reflection,
.btn-new-start {
  height: 96rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.btn-reflection {
  background: #FFFFFF;
  border: 4rpx solid #1A1A1A;
  color: #1A1A1A;
  box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
}

.btn-new-start {
  background: #1A1A1A;
  color: #FFFFFF;
  box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
}

/* Loading / Not Found */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #999999;
  gap: 24rpx;
}

.back-btn {
  background: #FFFFFF;
  border: 4rpx solid #1A1A1A;
  color: #1A1A1A;
  font-size: 28rpx;
  padding: 16rpx 64rpx;
  border-radius: 16rpx;
}
