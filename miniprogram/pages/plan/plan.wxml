<view class="container">
  <!-- Reward Toast -->
  <view class="reward-toast {{showReward ? 'show' : ''}}" wx:if="{{showReward}}">
    <view class="reward-content">
      <text class="reward-thumb">👍</text>
      <text class="reward-text">执行力 +2 · 咖啡豆 +1</text>
    </view>
  </view>

  <!-- Coach Greeting (ongoing state) -->
  <view class="coach-greeting" wx:if="{{plan && plan.status !== 'completed'}}">
    <image class="coach-avatar-small" src="/images/w-coach-avatar.png" mode="aspectFit"></image>
    <view class="speech-bubble">
      <text>{{encouragement}}</text>
    </view>
  </view>

  <!-- Plan Card (ongoing state) -->
  <view class="plan-card" wx:if="{{plan && plan.status !== 'completed'}}">
    <view class="plan-hint">W教练 正在为你准备最优计划..</view>
    <view class="plan-task">{{plan.task}}</view>
  </view>

  <!-- Steps List -->
  <view class="steps-section" wx:if="{{plan && plan.steps}}">
    <view class="section-title">执行步骤</view>
    <step-card
      wx:for="{{plan.steps}}"
      wx:key="index"
      step="{{item}}"
      index="{{index}}"
      completed="{{completedSteps.indexOf(index) > -1}}"
      skipped="{{skippedSteps.indexOf(index) > -1}}"
      bind:complete="onStepComplete"
      bind:skip="onStepSkip"
    />
  </view>

  <!-- Completion State -->
  <block wx:if="{{plan && plan.status === 'completed'}}">
    <!-- Completion Dialog -->
    <view class="completion-dialog">
      <view class="speech-bubble completion-bubble">
        <text>项目文件夹已创建，恭喜你迈出了坚实的第一步！</text>
      </view>
    </view>

    <!-- Full Body Coach -->
    <view class="coach-full">
      <image class="coach-full-img" src="/images/w-coach-full.png" mode="aspectFit"></image>
    </view>

    <!-- Completion Title -->
    <view class="completion-title-row">
      <text class="confetti">🎉</text>
      <text class="completion-title">你已完成任务!!</text>
      <text class="confetti">🎉</text>
    </view>

    <!-- Status Bar -->
    <view class="status-bar">
      <text>✅ {{completedSteps.length}}/{{totalSteps}}  ⏱️ {{completionDuration}}</text>
    </view>

    <!-- Completed Task List -->
    <view class="completed-tasks">
      <view class="completed-task-item" wx:for="{{plan.steps}}" wx:key="index">
        <view class="task-left">
          <text class="task-icon">{{item.icon || '📋'}}</text>
          <text class="task-content">{{item.content}}</text>
        </view>
        <view class="task-stamp">已完成</view>
      </view>
    </view>

    <!-- Action Buttons -->
    <view class="action-buttons">
      <view class="btn-reflection" bindtap="onReflection">感想</view>
      <view class="btn-new-start" bindtap="onBackHome">开始新的</view>
    </view>
  </block>

  <!-- Loading -->
  <view class="loading-state" wx:if="{{!plan && loading}}">
    <text>加载中...</text>
  </view>

  <!-- Not Found -->
  <view class="loading-state" wx:if="{{!plan && !loading}}">
    <text>计划不存在</text>
    <view class="back-btn" bindtap="onBackHome">返回首页</view>
  </view>
</view>
