<view class="container">
  <!-- Coach Header -->
  <view class="header">
    <image class="coach-avatar" src="/images/w-coach-avatar.png" mode="aspectFit"></image>
    <view class="speech-bubble">
      <text>你想搞定哪件事？</text>
    </view>
  </view>

  <!-- Input Area -->
  <view class="input-section {{inputFocused ? 'focused' : ''}}">
    <textarea
      class="task-input"
      placeholder="我躺在被窝里想事情，没去回客户的消息。"
      placeholder-class="input-placeholder"
      value="{{task}}"
      bindinput="onInput"
      bindfocus="onInputFocus"
      bindblur="onInputBlur"
      maxlength="200"
      auto-height
    />
    <view class="mic-icon">🎤</view>
  </view>

  <!-- Submit Button -->
  <view class="submit-btn {{loading ? 'disabled' : ''}}" bindtap="onSubmit">
    <text class="btn-text">创建计划</text>
  </view>
</view>
