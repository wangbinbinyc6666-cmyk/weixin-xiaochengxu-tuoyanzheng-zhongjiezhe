.container {
  padding: 32rpx;
  padding-bottom: 200rpx;
}

/* Coach Header */
.header {
  display: flex;
  flex-direction: column;
  padding: 24rpx 0 32rpx;
}

.coach-avatar {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  margin-bottom: 16rpx;
}

/* Speech Bubble */
.speech-bubble {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  font-size: 36rpx;
  color: #1A1A1A;
  box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.08);
  max-width: calc(100vw - 160rpx);
  position: relative;
  align-self: flex-start;
}

.speech-bubble::before {
  content: '';
  position: absolute;
  left: -16rpx;
  top: 20rpx;
  width: 0;
  height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-right: 16rpx solid #FFFFFF;
}

/* Input Section */
.input-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 2rpx solid #E0E0E0;
  padding: 24rpx;
  margin-bottom: 24rpx;
  position: relative;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.input-section.focused {
  border-color: #1A1A1A;
  border-width: 4rpx;
  box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
}

.task-input {
  width: calc(100% - 56rpx);
  height: 96rpx;
  min-height: 96rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.6;
}

.input-placeholder {
  color: #999999;
}

.mic-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  color: #999999;
}

/* Submit Button */
.submit-btn {
  width: 100%;
  height: 96rpx;
  background: #FFFFFF;
  border: 4rpx solid #1A1A1A;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
  box-sizing: border-box;
  box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
}

.submit-btn.disabled {
  background: #F5F5F5;
  border-color: #E0E0E0;
}

.submit-btn.disabled .btn-text {
  color: #999999;
}

.btn-text {
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 600;
}
