.container {
  padding: 32rpx;
  padding-bottom: 200rpx;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 36rpx;
}

.coach-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.coach-pixel {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8F0FE, #C5D9F5);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  border: 4rpx solid #4A90E2;
  overflow: hidden;
}

.coach-img {
  width: 100%;
  height: 100%;
}

.coach-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #4A90E2;
  background: #E8F0FE;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}

.greeting {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
}

.input-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
}

.task-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.input-placeholder {
  color: #CCCCCC;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: #4A90E2;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
  box-sizing: border-box;
}

.submit-btn.loading {
  background: #7ED321;
}

.btn-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.btn-icon {
  font-size: 36rpx;
}

.btn-text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-coach {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}

.recent-section {
  margin-top: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.recent-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.recent-task {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.recent-steps {
  font-size: 24rpx;
  color: #999999;
}

.recent-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.recent-status.completed {
  background: #E8F8D0;
  color: #7ED321;
}

.recent-status.ongoing {
  background: #E8F0FE;
  color: #4A90E2;
}

.recent-status.abandoned {
  background: #FFF0E0;
  color: #F5A623;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
