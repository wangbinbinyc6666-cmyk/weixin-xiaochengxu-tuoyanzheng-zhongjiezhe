.container {
  padding: 32rpx;
}

.profile-card {
  background: #1A1A1A;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.avatar {
  font-size: 80rpx;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.profile-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.profile-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.08);
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.stat-desc {
  font-size: 24rpx;
  color: #999999;
}

.recent-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.plan-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.08);
}

.plan-item-task {
  font-size: 28rpx;
  color: #1A1A1A;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-item-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999999;
}

.plan-item-status.completed {
  color: #2ECC71;
}

.plan-item-status.ongoing {
  color: #1A1A1A;
}

.plan-item-status.abandoned {
  color: #F39C12;
}

.settings-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.settings-section .section-title {
  padding: 24rpx 24rpx 0;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  border-bottom: 1rpx solid #F0F0F0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #999999;
}
